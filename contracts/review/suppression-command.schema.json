{
  "additionalProperties": false,
  "properties": {
    "actor_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Actor Id",
      "type": "string"
    },
    "command_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Command Digest",
      "type": "string"
    },
    "correlation_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Correlation Id",
      "type": "string"
    },
    "evidence_reference": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Evidence Reference",
      "type": "string"
    },
    "expected_revision": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Expected Revision"
    },
    "expires_at_utc": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expires At Utc"
    },
    "reason_code": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[A-Z][A-Z0-9_]*$",
      "title": "Reason Code",
      "type": "string"
    },
    "scopes": {
      "items": {
        "enum": [
          "discovery",
          "normalization",
          "export"
        ],
        "type": "string"
      },
      "title": "Scopes",
      "type": "array"
    },
    "target_id": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Target Id",
      "type": "string"
    },
    "target_kind": {
      "enum": [
        "candidate",
        "source_observation",
        "artifact",
        "source"
      ],
      "title": "Target Kind",
      "type": "string"
    }
  },
  "required": [
    "target_kind",
    "target_id",
    "scopes",
    "reason_code",
    "actor_id",
    "evidence_reference",
    "expected_revision",
    "command_digest",
    "correlation_id"
  ],
  "title": "SuppressionCommand",
  "type": "object"
}
