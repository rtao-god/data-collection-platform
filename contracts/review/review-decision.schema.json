{
  "additionalProperties": false,
  "properties": {
    "actor_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Actor Id",
      "type": "string"
    },
    "case_id": {
      "format": "uuid",
      "title": "Case Id",
      "type": "string"
    },
    "case_revision": {
      "minimum": 1,
      "title": "Case Revision",
      "type": "integer"
    },
    "command_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Command Digest",
      "type": "string"
    },
    "correlation_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Correlation Id",
      "type": "string"
    },
    "decided_at_utc": {
      "format": "date-time",
      "title": "Decided At Utc",
      "type": "string"
    },
    "decision_id": {
      "format": "uuid",
      "title": "Decision Id",
      "type": "string"
    },
    "evidence_references": {
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Evidence References",
      "type": "array"
    },
    "outcome": {
      "enum": [
        "accept_candidate",
        "reject_candidate",
        "approve_merge",
        "reject_merge",
        "request_recollection",
        "block_export"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "rationale": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    },
    "supersedes_decision_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Supersedes Decision Id"
    }
  },
  "required": [
    "decision_id",
    "case_id",
    "case_revision",
    "outcome",
    "actor_id",
    "rationale",
    "evidence_references",
    "supersedes_decision_id",
    "command_digest",
    "decided_at_utc",
    "correlation_id"
  ],
  "title": "ReviewDecision",
  "type": "object"
}
