{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "display_name": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Display Name",
      "type": "string"
    },
    "expected_entity_kind": {
      "maxLength": 80,
      "minLength": 2,
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Expected Entity Kind",
      "type": "string"
    },
    "note": {
      "anyOf": [
        {
          "maxLength": 1000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Note"
    },
    "osm_id": {
      "anyOf": [
        {
          "maxLength": 120,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Osm Id"
    },
    "provenance": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Provenance",
      "type": "string"
    },
    "reference_urls": {
      "items": {
        "format": "uri",
        "minLength": 1,
        "type": "string"
      },
      "title": "Reference Urls",
      "type": "array"
    },
    "row_number": {
      "exclusiveMinimum": 0,
      "title": "Row Number",
      "type": "integer"
    },
    "website": {
      "anyOf": [
        {
          "format": "uri",
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Website"
    }
  },
  "required": [
    "row_number",
    "expected_entity_kind",
    "display_name",
    "website",
    "osm_id",
    "reference_urls",
    "note",
    "provenance"
  ],
  "title": "ManualSeedRow",
  "type": "object"
}
