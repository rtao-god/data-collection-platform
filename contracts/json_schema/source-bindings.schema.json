{
  "$defs": {
    "CrawlBudgetNotApplicable": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "const": "not_applicable",
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "state"
      ],
      "title": "CrawlBudgetNotApplicable",
      "type": "object"
    },
    "DefinedCrawlBudget": {
      "additionalProperties": false,
      "properties": {
        "max_total_bytes": {
          "exclusiveMinimum": 0,
          "title": "Max Total Bytes",
          "type": "integer"
        },
        "max_work_units": {
          "exclusiveMinimum": 0,
          "title": "Max Work Units",
          "type": "integer"
        },
        "state": {
          "const": "defined",
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "state",
        "max_work_units",
        "max_total_bytes"
      ],
      "title": "DefinedCrawlBudget",
      "type": "object"
    },
    "FileSeedProvider": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "enum": [
            "csv",
            "json",
            "jsonl"
          ],
          "title": "Format",
          "type": "string"
        },
        "kind": {
          "const": "file",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "maxLength": 240,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_./-]*$",
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "path",
        "format"
      ],
      "title": "FileSeedProvider",
      "type": "object"
    },
    "OsmQueryDeclaration": {
      "additionalProperties": false,
      "description": "Campaign-declared Overpass query. The polygon comes from verified geography.",
      "properties": {
        "element_types": {
          "items": {
            "enum": [
              "node",
              "relation",
              "way"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Element Types",
          "type": "array"
        },
        "maximum_elements": {
          "default": 25000,
          "maximum": 100000,
          "minimum": 1,
          "title": "Maximum Elements",
          "type": "integer"
        },
        "tag_filters": {
          "items": {
            "$ref": "#/$defs/OsmTagFilterDeclaration"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Tag Filters",
          "type": "array"
        },
        "timeout_seconds": {
          "default": 60,
          "maximum": 180,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        }
      },
      "required": [
        "element_types",
        "tag_filters"
      ],
      "title": "OsmQueryDeclaration",
      "type": "object"
    },
    "OsmTagFilterDeclaration": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "pattern": "^[A-Za-z0-9_:.-]{1,64}$",
          "title": "Key",
          "type": "string"
        },
        "values": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "key",
        "values"
      ],
      "title": "OsmTagFilterDeclaration",
      "type": "object"
    },
    "SeedNotApplicable": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "not_applicable",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "SeedNotApplicable",
      "type": "object"
    },
    "SeedRoutePageInterest": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "maxLength": 80,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Key",
          "type": "string"
        },
        "priority": {
          "exclusiveMinimum": 0,
          "title": "Priority",
          "type": "integer"
        },
        "tokens": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Tokens",
          "type": "array"
        }
      },
      "required": [
        "key",
        "tokens",
        "priority"
      ],
      "title": "SeedRoutePageInterest",
      "type": "object"
    },
    "SeedRoutingConfigured": {
      "additionalProperties": false,
      "properties": {
        "routes": {
          "items": {
            "$ref": "#/$defs/SeedWebsiteRoute"
          },
          "minItems": 1,
          "title": "Routes",
          "type": "array"
        },
        "state": {
          "const": "configured",
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "state",
        "routes"
      ],
      "title": "SeedRoutingConfigured",
      "type": "object"
    },
    "SeedRoutingNotConfigured": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "const": "not_configured",
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "state"
      ],
      "title": "SeedRoutingNotConfigured",
      "type": "object"
    },
    "SeedWebsiteRoute": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "maxLength": 80,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Key",
          "type": "string"
        },
        "page_interests": {
          "items": {
            "$ref": "#/$defs/SeedRoutePageInterest"
          },
          "minItems": 1,
          "title": "Page Interests",
          "type": "array"
        },
        "route_kind": {
          "const": "official_website_page",
          "title": "Route Kind",
          "type": "string"
        },
        "selection": {
          "enum": [
            "exclusive",
            "fan_out"
          ],
          "title": "Selection",
          "type": "string"
        },
        "source_binding": {
          "maxLength": 80,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Source Binding",
          "type": "string"
        },
        "source_field": {
          "const": "website",
          "title": "Source Field",
          "type": "string"
        },
        "target_binding": {
          "maxLength": 80,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Target Binding",
          "type": "string"
        }
      },
      "required": [
        "key",
        "source_field",
        "source_binding",
        "target_binding",
        "route_kind",
        "selection",
        "page_interests"
      ],
      "title": "SeedWebsiteRoute",
      "type": "object"
    },
    "SourceBinding": {
      "additionalProperties": false,
      "properties": {
        "capability": {
          "enum": [
            "browser_fetch",
            "http_fetch",
            "manual_import",
            "openstreetmap_query",
            "wikidata_entity_query"
          ],
          "title": "Capability",
          "type": "string"
        },
        "connector_key": {
          "maxLength": 80,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Connector Key",
          "type": "string"
        },
        "crawl_budget": {
          "discriminator": {
            "mapping": {
              "defined": "#/$defs/DefinedCrawlBudget",
              "not_applicable": "#/$defs/CrawlBudgetNotApplicable"
            },
            "propertyName": "state"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/CrawlBudgetNotApplicable"
            },
            {
              "$ref": "#/$defs/DefinedCrawlBudget"
            }
          ],
          "title": "Crawl Budget"
        },
        "extraction_profile": {
          "maxLength": 100,
          "minLength": 3,
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Extraction Profile",
          "type": "string"
        },
        "key": {
          "maxLength": 80,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Key",
          "type": "string"
        },
        "normalization_profile": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 2,
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalization Profile"
        },
        "osm_query": {
          "anyOf": [
            {
              "$ref": "#/$defs/OsmQueryDeclaration"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schedule_enabled": {
          "title": "Schedule Enabled",
          "type": "boolean"
        },
        "seed_provider": {
          "discriminator": {
            "mapping": {
              "file": "#/$defs/FileSeedProvider",
              "not_applicable": "#/$defs/SeedNotApplicable"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/FileSeedProvider"
            },
            {
              "$ref": "#/$defs/SeedNotApplicable"
            }
          ],
          "title": "Seed Provider"
        },
        "source_entity_kind": {
          "anyOf": [
            {
              "enum": [
                "organization",
                "place",
                "provider"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Entity Kind"
        },
        "source_field_projection": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SourceFieldProjection"
          },
          "title": "Source Field Projection",
          "type": "array"
        },
        "source_key": {
          "maxLength": 80,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Source Key",
          "type": "string"
        },
        "source_policy_key": {
          "maxLength": 80,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Source Policy Key",
          "type": "string"
        },
        "wikidata_classification": {
          "anyOf": [
            {
              "$ref": "#/$defs/WikidataClassificationDeclaration"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "wikidata_query": {
          "anyOf": [
            {
              "$ref": "#/$defs/WikidataEntityQueryDeclaration"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "key",
        "source_key",
        "connector_key",
        "source_policy_key",
        "capability",
        "seed_provider",
        "crawl_budget",
        "schedule_enabled",
        "extraction_profile"
      ],
      "title": "SourceBinding",
      "type": "object"
    },
    "SourceFieldProjection": {
      "additionalProperties": false,
      "description": "One explicit source field -> candidate field decision.\n\nDeclared in the campaign so a new source field cannot enter a candidate without\nan explicit, versioned projection decision.",
      "properties": {
        "candidate_field": {
          "enum": [
            "names",
            "phones",
            "emails",
            "website_urls",
            "addresses",
            "coordinates"
          ],
          "title": "Candidate Field",
          "type": "string"
        },
        "source_aliases": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Source Aliases",
          "type": "array"
        },
        "source_field": {
          "pattern": "^[a-z][a-z0-9_.:]{0,99}$",
          "title": "Source Field",
          "type": "string"
        }
      },
      "required": [
        "source_field",
        "candidate_field"
      ],
      "title": "SourceFieldProjection",
      "type": "object"
    },
    "WikidataClassificationDeclaration": {
      "additionalProperties": false,
      "description": "The operator-authored Wikidata class -> campaign category correspondence.\n\nAn item's `instance of` statements are user-editable, so the correspondence is\nconfiguration: an entity whose classes do not match it exactly stays ambiguous.",
      "properties": {
        "campaign_category": {
          "maxLength": 80,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Campaign Category",
          "type": "string"
        },
        "compatible_class_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Compatible Class Ids",
          "type": "array"
        },
        "studio_class_id": {
          "title": "Studio Class Id",
          "type": "string"
        }
      },
      "required": [
        "studio_class_id",
        "campaign_category"
      ],
      "title": "WikidataClassificationDeclaration",
      "type": "object"
    },
    "WikidataEntityQueryDeclaration": {
      "additionalProperties": false,
      "description": "The operator-reviewed entity set one Wikidata acquisition may read.\n\nIt is a declared list, not a discovery result: nothing about it is inferred at run\ntime, and it is bounded so an acquisition cannot widen into a crawl.",
      "properties": {
        "entity_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Entity Ids",
          "type": "array"
        },
        "label_languages": {
          "default": [
            "de",
            "en"
          ],
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Label Languages",
          "type": "array"
        }
      },
      "required": [
        "entity_ids"
      ],
      "title": "WikidataEntityQueryDeclaration",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/SourceBinding"
      },
      "minItems": 1,
      "title": "Items",
      "type": "array"
    },
    "schema_revision": {
      "maxLength": 100,
      "minLength": 3,
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "title": "Schema Revision",
      "type": "string"
    },
    "seed_routing": {
      "discriminator": {
        "mapping": {
          "configured": "#/$defs/SeedRoutingConfigured",
          "not_configured": "#/$defs/SeedRoutingNotConfigured"
        },
        "propertyName": "state"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/SeedRoutingNotConfigured"
        },
        {
          "$ref": "#/$defs/SeedRoutingConfigured"
        }
      ],
      "title": "Seed Routing"
    }
  },
  "required": [
    "schema_revision",
    "items"
  ],
  "title": "SourceBindingsDocument",
  "type": "object"
}
