      "descriptions": {
        "de-DE": {
          "origin": "editorial",
          "reason": null,
          "review_ref": "e22c66d4-897c-5327-9a05-a66c2aa4dee1",
          "review_state": "approved",
          "source_evidence_digest_sha256": "efe191d999f72fefe06b8d6a9ba8f59a4bc2dd06ec40775e2d06bda05683deb8",
          "state": "approved",
          "text": "TRIXX Studios ist ein Tonstudio in Berlin. Es bietet Musikproduktion, Aufnahmen, Mixing und Mastering an. Für einzelne Projekte kann das Team Produzenten, Songwriter und Musiker aus seinem Netzwerk einbeziehen.",
          "text_digest_sha256": "bae662a1f178eb041b351d406cd2b840b174491fb9454224977e528219158712"
        },
        "en-GB": {
          "origin": "editorial",
          "reason": null,
          "review_ref": "2b2e55ab-3219-59c4-a814-404b5edf898f",
          "review_state": "approved",
          "source_evidence_digest_sha256": "f97878c936463227e75295da4270ae7a74aaef60ed4f693badcef989606828bf",
          "state": "approved",
          "text": "TRIXX Studios is a Berlin recording facility offering music production, recording, mixing and mastering. Projects can also draw on the studio’s network of producers, songwriters and musicians.",
          "text_digest_sha256": "bafbf45e64229345275787dbdd88e30462182c21c853a38ac8736b5659cf45a5"
        },
        "ru-RU": {
          "origin": "editorial",
          "reason": null,
          "review_ref": "564c10fc-f527-5a1a-ab6a-ae6ee4e1d65e",
          "review_state": "approved",
          "source_evidence_digest_sha256": "efe191d999f72fefe06b8d6a9ba8f59a4bc2dd06ec40775e2d06bda05683deb8",
          "state": "approved",
          "text": "TRIXX Studios — студия звукозаписи в Берлине, предлагающая музыкальное продюсирование, запись, сведение и мастеринг. При необходимости к проектам привлекают продюсеров, авторов песен и музыкантов из профессиональной сети студии.",
          "text_digest_sha256": "42879aa7bccdc2a52c425baf6521f5cec14dc22c8a3d11bae361016c1ec7542d"
        }
      },
